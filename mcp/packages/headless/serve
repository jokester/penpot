#!/usr/bin/env bash
#
# Start, stop and restart the Penpot MCP endpoint.
#
# The launcher serves one MCP endpoint that takes the document as an argument,
# so an agent's configuration is a single static URL:
#
#     { "penpot": { "url": "http://127.0.0.1:4400/mcp" } }
#
#   ./serve start | stop | restart | status | logs
#
# Address: $HOST and $PORT, or --listen passed through, defaulting to
# 127.0.0.1:4400. Anything after the subcommand reaches the launcher, so
# `./serve restart --listen 0.0.0.0:4500` works.
#
# The pid is written to a file rather than looked up afterwards. Finding this
# process by pattern is a trap worth avoiding: `pgrep -f mcp-headless` also
# matches the shell running the command that contains that string, and killing
# the match kills your own terminal. Node also reports its command name as
# `MainThread` here, so filtering on that misses it. The pid file is checked
# against /proc/<pid>/cmdline before anything is signalled, so a recycled pid
# cannot be killed by mistake.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/mcp-headless"
PIDFILE="$STATE/serve.pid"
LOGFILE="$STATE/serve.log"

# Quitting ends every lane it opened, and a browser can be slow to go.
STOP_TIMEOUT=45

usage() { sed -n '3,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

# The pid in the file, if it is alive and is in fact our launcher.
running_pid() {
    local pid
    [[ -f "$PIDFILE" ]] || return 1
    pid="$(cat "$PIDFILE" 2>/dev/null || true)"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    # Confirm identity before trusting it: pids are recycled.
    tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q 'mcp-headless' || return 1
    echo "$pid"
}

start() {
    local pid
    if pid="$(running_pid)"; then
        echo "already running (pid $pid); use restart"
        return 0
    fi

    mkdir -p "$STATE"
    # setsid so it survives this shell, and no pipeline so $! is the launcher
    # itself rather than whatever a pipeline ended with.
    setsid nohup node "$HERE/bin/mcp-headless.ts" "$@" >>"$LOGFILE" 2>&1 < /dev/null &
    echo $! > "$PIDFILE"

    # Wait for the endpoint rather than assume it: a bad address or a port
    # already taken should be reported here, not discovered by an agent.
    local waited=0
    until grep -q 'mcp endpoint' "$LOGFILE" 2>/dev/null; do
        if ! running_pid > /dev/null; then
            echo "failed to start; last lines of $LOGFILE:" >&2
            tail -n 15 "$LOGFILE" >&2
            rm -f "$PIDFILE"
            return 1
        fi
        [[ $waited -lt 300 ]] || { echo "started but no endpoint after 30s; see $LOGFILE" >&2; return 1; }
        sleep 0.1
        waited=$((waited + 1))
    done

    echo "started (pid $(cat "$PIDFILE"))  $(grep -h 'mcp endpoint' "$LOGFILE" | tail -1 | sed 's/^ *//')"
}

stop() {
    local pid
    if ! pid="$(running_pid)"; then
        echo "not running"
        rm -f "$PIDFILE"
        return 0
    fi

    # TERM runs the same shutdown as quitting the TUI: every lane ends and the
    # container is left as it was found.
    kill -TERM "$pid"
    local waited=0
    while kill -0 "$pid" 2>/dev/null; do
        if [[ $waited -ge $((STOP_TIMEOUT * 10)) ]]; then
            echo "did not stop within ${STOP_TIMEOUT}s; sending KILL (lanes may be left behind)" >&2
            kill -KILL "$pid" 2>/dev/null || true
            break
        fi
        sleep 0.1
        waited=$((waited + 1))
    done

    rm -f "$PIDFILE"
    echo "stopped"
}

status() {
    local pid
    if pid="$(running_pid)"; then
        echo "running   pid $pid"
        grep -h 'mcp endpoint' "$LOGFILE" 2>/dev/null | tail -1 | sed 's/^ */endpoint  /'
    else
        echo "not running"
    fi
    # Anything a previous run left in the container, which is worth knowing
    # whether or not the launcher is up.
    node "$HERE/bin/mcp-headless.ts" --no-serve --check || true
}

case "${1:-}" in
    start)   shift; start "$@" ;;
    stop)    shift; stop ;;
    restart) shift; stop; start "$@" ;;
    status)  shift; status ;;
    logs)    shift; tail -n "${1:-40}" -f "$LOGFILE" ;;
    ""|-h|--help) usage ;;
    *) echo "unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
