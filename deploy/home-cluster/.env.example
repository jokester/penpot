# Penpot home-cluster deployment. Copy to .env and fill in.
# Every value here is read by docker-compose.yaml; none are optional
# unless the comment says so.

PENPOT_VERSION=2.17

# Public hostname served through the Cloudflare tunnel (no scheme).
PENPOT_HOST=penpot.example.org

# Bind address for the two frontends. 0.0.0.0 lets an ingress or a worker on
# another host reach them; set 127.0.0.1 to require an SSH forward instead.
PENPOT_BIND=0.0.0.0

# THE PORT THE INTERNET REACHES: penpot-frontend-public. Point the Cloudflare
# tunnel at <this host>:<PENPOT_PUBLIC_PORT>. Nothing else should be exposed.
PENPOT_PUBLIC_PORT=9002

# The worker path. Never give this to the tunnel.
PENPOT_LOCAL_PORT=9001

# Origin the worker's browser uses for the line above. It must be one the
# browser treats as trustworthy, because hardened session cookies are Secure;
# http://localhost qualifies, http://a-lan-name does not. A worker on another
# machine SSH-forwards this port and still calls it localhost.
PENPOT_LOCAL_URI=http://localhost:9001

# The mail catcher exposes every message the instance sends, password-reset
# links included. Keep it on loopback.
PENPOT_MAILCATCH_BIND=127.0.0.1
PENPOT_MAILCATCH_PORT=1080

# Only used with `docker compose --profile tunnel up -d`.
CLOUDFLARED_TOKEN=

# Master key deriving every subsystem key. Generate ONCE with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Back it up. Changing it invalidates all sessions and pending invitations.
PENPOT_SECRET_KEY=CHANGE-ME

POSTGRES_PASSWORD=CHANGE-ME

# Shared flag string. Per-frontend auth overrides are appended in the compose
# file; the last occurrence of a flag wins (common/src/app/common/flags.cljc).
PENPOT_FLAGS_BASE=enable-smtp enable-prepl-server enable-mcp enable-secure-session-cookies enable-login-with-oidc enable-oidc-registration disable-registration

# --- Authelia ---------------------------------------------------------------
# Browser-facing base. Verified reachable and serving OIDC discovery.
AUTHELIA_PUBLIC_URI=https://id.ihate.work
# What the penpot-backend CONTAINER can reach. If there is no internal route,
# set this to the same value as AUTHELIA_PUBLIC_URI.
AUTHELIA_INTERNAL_URI=https://id.ihate.work
# Space-separated hosts the backend is allowed to call. Must list every host
# appearing in the two URIs above, or SSRF protection blocks the token call.
PENPOT_SSRF_ALLOWED_HOSTS=id.ihate.work

PENPOT_OIDC_CLIENT_ID=penpot
PENPOT_OIDC_CLIENT_SECRET=CHANGE-ME

# --- Mail -------------------------------------------------------------------
PENPOT_SMTP_FROM=no-reply@example.org

# --- Limits -----------------------------------------------------------------
# 350 MiB. Note Cloudflare caps request bodies well below this on non-Enterprise
# plans, so large imports must use the SSH path. See HANDOFF.md.
PENPOT_MAX_BODY=367001600

# Worker container only (`docker compose --profile worker up -d`). Must match
# playwright version in mcp/packages/host/package.json.
PLAYWRIGHT_VERSION=1.63.0
# Repo root, as seen from this directory. Absolute is safer under systemd.
PENPOT_SRC=../..
