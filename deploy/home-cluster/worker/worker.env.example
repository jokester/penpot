# MCP worker -- the browser that hosts Penpot's MCP plugin.
# Copy to worker.env and fill in. Values are quoted: the workspace URL has '&'.
#
# Reachability: PENPOT_ORIGIN must be an origin this machine's browser treats
# as trustworthy, because hardened session cookies are Secure. localhost
# qualifies over plain http; a LAN hostname does not. If the worker runs on a
# different machine from Penpot, SSH-forward the port and keep saying localhost:
#   ssh -N -L 9001:127.0.0.1:9001 <penpot-host>

PENPOT_ORIGIN="http://localhost:9001"

# Password account made with manage.py. Never a human's SSO account.
PENPOT_EMAIL="worker@penpot.local"
PENPOT_PASSWORD="CHANGE-ME"

# The file the worker drives. BOTH ids are required -- a workspace URL with only
# file-id renders an empty page and the plugin never starts.
PENPOT_FILE_URL="http://localhost:9001/#/workspace?team-id=CHANGE-ME&file-id=CHANGE-ME"

# What an MCP client connects to. Same string Penpot shows under
# Settings > Integrations. The token is a secret: it grants execute_code
# against whatever file the worker has open.
PENPOT_MCP_URL="http://localhost:9001/mcp/stream?userToken=CHANGE-ME"

# Keeps the worker's browser profile away from any other Penpot session.
PENPOT_PROFILE_DIR="$HOME/.cache/penpot-headless/profile-mcp-worker"
