#!/usr/bin/env python3
"""Create and configure an MCP worker account, and write its env file.

A worker is a Penpot account like any other, with a password so it can log in
without a human.  People log in through Authelia instead; this is the one kind
of account that needs a password, and keeping it separate bounds what a leaked
worker credential reaches.

  provision-worker --email worker-a@penpot.local
  provision-worker --email worker-a@penpot.local --invite '<link or token>'

The invite is how a worker reaches documents it does not own.  Invite the
worker from Penpot (Team > Invitations), copy the link, and pass it here; the
worker accepts it and can then drive that team's files.  Without one it only
sees its own scratch project.

Stdlib only.  Runs `docker compose exec penpot-backend python3 manage.py` to
create the profile, then talks to the RPC API for the rest.
"""

import argparse
import json
import re
import secrets
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
WORKER_DIR = HERE / "worker"
TOKEN_RE = re.compile(r"[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_.-]{20,}")


def rpc(origin, command, payload, cookie=None):
    headers = {"Content-Type": "application/json", "Accept": "application/json"}
    if cookie:
        headers["Cookie"] = cookie
    request = urllib.request.Request(
        f"{origin}/api/rpc/command/{command}", data=json.dumps(payload).encode(), headers=headers
    )
    with urllib.request.urlopen(request, timeout=10) as response:
        body = response.read().decode()
        return (json.loads(body) if body.strip() else None), response.headers.get("Set-Cookie", "")


def login(origin, email, password):
    profile, set_cookie = rpc(origin, "login-with-password", {"email": email, "password": password})
    # Secure cookie over loopback http: browsers send it, http.cookiejar does
    # not, so it is carried by hand here.
    match = re.search(r"(auth-token=[^;]+)", set_cookie or "")
    if not match:
        raise RuntimeError("login returned no auth-token cookie")
    return profile, match.group(1)


def create_profile(name, email, password):
    result = subprocess.run(
        ["docker", "compose", "exec", "-T", "penpot-backend", "python3", "manage.py",
         "create-profile", "-n", name, "-e", email, "-p", password,
         "--skip-tutorial", "--skip-walkthrough"],
        cwd=HERE, capture_output=True, text=True,
    )
    output = (result.stdout + result.stderr).strip()
    if result.returncode != 0 and "already exists" not in output.lower():
        raise RuntimeError("create-profile failed: %s" % output[:300])
    return output


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--email", required=True)
    parser.add_argument("--password", help="default: generated")
    parser.add_argument("--name", default=None, help="display name; default derived from the email")
    parser.add_argument("--origin", default="http://localhost:9001")
    parser.add_argument("--invite", default="", help="invitation link or token, to join a team")
    parser.add_argument("--file-name", default="worker-scratch", help="scratch file to create; '' to skip")
    parser.add_argument("--env-out", default=None, help="default: worker/<local part of email>.env")
    args = parser.parse_args()

    password = args.password or secrets.token_urlsafe(18)
    name = args.name or args.email.split("@")[0]
    env_out = Path(args.env_out) if args.env_out else WORKER_DIR / f"{args.email.split('@')[0]}.env"

    print(create_profile(name, args.email, password))
    profile, cookie = login(args.origin, args.email, password)
    print("logged in as", args.email)

    if args.invite:
        match = TOKEN_RE.search(args.invite)
        if not match:
            print("could not find a token in --invite", file=sys.stderr)
            return 2
        joined, _ = rpc(args.origin, "verify-token", {"token": match.group(0)}, cookie)
        print("joined team:", (joined or {}).get("teamId"), "as", (joined or {}).get("role"))
        profile, cookie = login(args.origin, args.email, password)

    # MCP off by default; the token is what the plugin presents, and creating
    # one deletes any previous mcp token for this profile.
    token, _ = rpc(args.origin, "create-access-token", {"name": "MCP", "type": "mcp"}, cookie)
    rpc(args.origin, "update-profile-props",
        {"props": {"mcpEnabled": True, "onboardingViewed": True, "releaseNotesViewed": "2.17"}}, cookie)
    print("MCP enabled, token minted")

    team_id = profile["defaultTeamId"]
    file_id = ""
    if args.file_name:
        created, _ = rpc(args.origin, "create-file",
                         {"name": args.file_name, "projectId": profile["defaultProjectId"]}, cookie)
        file_id = created["id"]
        print("scratch file:", args.file_name, file_id)

    env_out.parent.mkdir(parents=True, exist_ok=True)
    env_out.write_text(
        "# Generated by provision-worker. Holds a password and an MCP token.\n"
        f'PENPOT_ORIGIN="{args.origin}"\n'
        f'PENPOT_EMAIL="{args.email}"\n'
        f'PENPOT_PASSWORD="{password}"\n'
        "# Both ids are required: a workspace URL with only file-id renders an\n"
        "# empty page. run-mcp-worker.py rewrites them per document.\n"
        f'PENPOT_FILE_URL="{args.origin}/#/workspace?team-id={team_id}&file-id={file_id}"\n'
        f'PENPOT_MCP_URL="{args.origin}/mcp/stream?userToken={token["token"]}"\n'
        f'PENPOT_PROFILE_DIR="$HOME/.cache/penpot-headless/profile-{args.email.split("@")[0]}"\n'
    )
    env_out.chmod(0o600)
    print("wrote", env_out)
    print("\nNext: ./run-mcp-worker.py   (the account appears in the Account field)")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (urllib.error.HTTPError, urllib.error.URLError, RuntimeError, KeyError) as exc:
        print("failed: %s" % exc, file=sys.stderr)
        sys.exit(1)
